# Toolkit REST access. Generate independent random values; blank disables access.
API_KEY=
ADMIN_API_KEY=
# JSON list of browser origins allowed to call this service. Closed by default.
CORS_ORIGINS=[]

# One directory per system, e.g. ./systems/demo/demo.json:
# {"type": "successfactors", "production": false, "company_id": "demo",
#  "host": "api4preview.sapsf.com", "token_url": "https://api4preview.sapsf.com/oauth/token",
#  "client_key": "...", "user_id": "..."}
# plus ./systems/demo/private-key.pem (mode 600) and signing-cert.crt.
SYSTEMS_DIR=./systems
# Hosts outside the SAP datacenter domains a system file may use.
# SF_ALLOWED_HOSTS=["sf.example.internal"]
REQUEST_TIMEOUT=120
# Per-call limits (defaults shown): one response, all pages of one extract,
# duration of one extract, distinct values in extract-by-filter-in.
# MAX_RESPONSE_BYTES=52428800
# MAX_EXTRACT_BYTES=524288000
# MAX_EXTRACT_SECONDS=1800
# MAX_FILTER_VALUES=10000
# Where payloads land; MCP writes under {RESULTS_DIR}/mcp/. Absolute is safest.
RESULTS_DIR=./results
# Days to keep files under {RESULTS_DIR}/mcp/ (deleted on the next write); 0 keeps them.
# RESULTS_RETENTION_DAYS=7

# PII token vault (see docs/MCP_SERVER.md "PII tokenization"). Tier and extra fields are set per system.
# Must persist and must not be inside RESULTS_DIR.
# PII_VAULT_DIR=./pii_vault

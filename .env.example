# Toolkit REST access. Generate independent random values; blank disables access.
API_KEY=
ADMIN_API_KEY=
# JSON list of browser origins allowed to call this service. Closed by default.
CORS_ORIGINS=[]

# SuccessFactors OAuth2 SAML Bearer defaults. Replace before live requests.
SF_HOST=example.invalid
# JSON list of extra hosts a per-request connection override may target.
# SF_HOST and *.successfactors.com/.eu/.cn, *.sapsf.com/.eu/.cn are always allowed.
SF_ALLOWED_HOSTS=[]
SF_CLIENT_KEY=
SF_USER_ID=APIUSER
SF_COMPANY_ID=demo
SF_TOKEN_URL=https://example.invalid/oauth/token
SF_ODATA_VERSION=v2
REQUEST_TIMEOUT=120
# Where payloads land; MCP writes under {RESULTS_DIR}/mcp/. Absolute is safest.
RESULTS_DIR=./results

# Local keypair store. Docker Compose overrides this to /data/tenants.
TENANT_KEYS_DIR=./tenants
# Key lookup: tenant store, per-company base64 PEM, global base64 PEM, file path.
# SF_PRIVATE_KEY_PEM_DEMO=
# SF_PRIVATE_KEY_PEM=
SF_PRIVATE_KEY_PATH=./secrets/keypair_{company_id}/private_key.pem
